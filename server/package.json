{
  "name": "employee-server",
  "version": "1.0.0",
  "description": "Employee management system with Express",
  "main": "dist/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "nodemon --exec ts-node src/server.ts",
    "build": "tsc",
    "clean": "rm -rf dist node_modules",
    "dev:tsc": "tsc --watch",
    "dev:node": "nodemon dist/server.js",
    "dev:all": "concurrently \"npm run dev:tsc\" \"npm run dev:node\""
  },
  "dependencies": {
    "@types/uuid": "^10.0.0",
    "async-mutex": "^0.4.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1",
    "proper-lockfile": "^4.1.2",
    "write-file-atomic": "^7.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.15",
    "@types/express": "^4.17.20",
    "@types/multer": "^1.4.7",
    "@types/node": "^20.10.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/write-file-atomic": "^4.0.3",
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.0"
  },
  "keywords": [
    "express",
    "typescript",
    "employee-management"
  ],
  "author": "",
  "license": "ISC"
}
